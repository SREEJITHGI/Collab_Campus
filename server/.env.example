# CollabCampus Server Environment Variables

# Application
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=super_secret_jwt_key_collabcampus_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
# Either provide DATABASE_URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collabcampus
# Or individual parameters:
PGHOST=localhost
PGPORT=5432
PGDATABASE=collabcampus
PGUSER=postgres
PGPASSWORD=postgres

# If PostgreSQL is not installed locally, set USE_PGLITE=true to use the embedded PostgreSQL runtime
USE_PGLITE=true
PGLITE_DATA_DIR=./data/pglite

# File Uploads
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=./uploads
